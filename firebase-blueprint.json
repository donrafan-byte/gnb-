            "eliminar",
            "alerta_sos",
            "gps_estado",
            "cambio_estado",
            "acceso_aprobado",
            "acceso_expulsado",
            "acceso_rehabilitado",
            "acceso_por_codigo",
            "codigo_secreto_creado",
            "codigo_secreto_revocado",
            "cambio_privilegio"
          ]
        },
        "entidad": {
          "type": "string",
          "enum": [
            "sesion",
            "perfil",
            "commission",
            "incident",
            "patrolPoint",
            "gangZone",
            "friendlyForce",
            "zoneUnit",
            "wantedRecord",
            "verificationLog",
            "acceso",
            "codigo_secreto"
          ]
        },
        "entidadId": { "type": "string", "maxLength": 128 },
        "resumen": { "type": "string", "minLength": 2, "maxLength": 300 },
        "severidad": { "type": "string", "enum": ["normal", "sensible", "alerta_mal_uso"] },
        "dispositivo": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "actorUid",
        "actorEmail",
        "actorNombre",
        "actorGrado",
        "actorCedula",
        "accion",
        "entidad",
        "entidadId",
        "resumen",
        "severidad",
        "dispositivo",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/officers/{officerId}": {
      "schema": { "$ref": "#/entities/Officer" },
      "description": "Operator profile and official registration record isolated per authenticated UID."
    },
    "/liveLocations/{locationId}": {
      "schema": { "$ref": "#/entities/LiveLocation" },
      "description": "Real-time GPS position of authenticated officers while on commission."
    },
    "/commissions/{commissionId}": {
      "schema": { "$ref": "#/entities/Commission" },
      "description": "Operational military and police commissions managed across CZGNB-23 Trujillo (D-231, DCR 23-1, DESUR-23)."
    },
    "/incidents/{incidentId}": {
      "schema": { "$ref": "#/entities/Incident" },
      "description": "Georeferenced security incidents forming the Trujillo crime map."
    },
    "/patrolPoints/{pointId}": {
      "schema": { "$ref": "#/entities/PatrolPoint" },
      "description": "Georeferenced patrolled checkpoints with sector observations and site photos."
    },
    "/gangZones/{zoneId}": {
      "schema": { "$ref": "#/entities/GangZone" },
      "description": "Shared operational catalog of criminal group (GEDO) operating zones visible to all authorized CZGNB-23 officers; operators may add and edit their own entries while supervisors and admins moderate the catalog."
    },
    "/friendlyForces/{forceId}": {
      "schema": { "$ref": "#/entities/FriendlyForce" },
      "description": "Shared operational catalog of allied security forces (PNB, CICPC, Estadal, Municipal, CONAS, GNB, Guardacostas) visible to all authorized CZGNB-23 officers; operators may add and edit their own entries while supervisors and admins moderate the catalog."
    },
    "/zoneUnits/{unitId}": {
      "schema": { "$ref": "#/entities/ZoneUnit" },
      "description": "Shared organizational catalog of CZGNB-23 Trujillo units (Comando de Zona HQ, 3 Destacamentos D-231/DCR-23-1/DESUR-23, Companias, and Puestos/PACs) visible to all authorized officers."
    },
    "/wantedRecords/{recordId}": {
      "schema": { "$ref": "#/entities/WantedRecord" },
      "description": "Judicial wanted persons and stolen/wanted vehicles registry."
    },
    "/verificationLogs/{logId}": {
      "schema": { "$ref": "#/entities/VerificationLog" },
      "description": "Historical database of verified persons and vehicles checked by commissions."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable append-only user activity and misuse audit trail."
    },
    "/accessCodes/{codeHash}": {
      "schema": { "$ref": "#/entities/AccessCode" },
      "description": "SHA-256 hash-indexed secret authorization codes issued and revoked exclusively by the Command Administrator."
    }
  }
}
