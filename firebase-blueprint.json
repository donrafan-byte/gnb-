        "codeHint": { "type": "string", "minLength": 4, "maxLength": 32 },
        "active": { "type": "boolean" },
        "maxUses": { "type": "integer", "minimum": 1, "maximum": 100 },
        "usedCount": { "type": "integer", "minimum": 0, "maximum": 100 },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdByEmail": { "type": "string", "format": "email", "minLength": 3, "maxLength": 150 },
        "lastUsedByUid": { "type": "string", "maxLength": 128 },
        "lastUsedByEmail": { "type": "string", "maxLength": 150 },
